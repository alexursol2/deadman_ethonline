# Copy to .env and fill in. .env is gitignored — never commit a key.
#
# Hedera portal accounts MUST be ECDSA. ED25519 has no EVM alias and will not work.
# https://portal.hedera.com -> testnet -> key type ECDSA -> 1000 HBAR / 24h, up to 5 accounts.

HEDERA_TESTNET_RPC=https://testnet.hashio.io/api
HEDERA_CHAIN_ID=296
MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com
HASHSCAN_BASE=https://hashscan.io/testnet

# ECDSA hex private key, with or without the 0x prefix
HEDERA_OPERATOR_KEY=
# Hedera entity id of the same account, e.g. 0.0.123456
HEDERA_OPERATOR_ID=

# Deployed spike contract, filled in by scripts/deploy.ts
SPIKE_CONTRACT_ADDRESS=

# x402 — Hedera track requires settlement through the Blocky402 facilitator
X402_FACILITATOR_URL=https://api.testnet.blocky402.com
