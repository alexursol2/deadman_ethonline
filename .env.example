# Copy to .env and fill in. .env is gitignored — never commit a key.
#
# Hedera portal accounts MUST be ECDSA. ED25519 has no EVM alias and will not work.
# https://portal.hedera.com -> testnet -> key type ECDSA -> 1000 HBAR / 24h, up to 5 accounts.

HEDERA_TESTNET_RPC=https://testnet.hashio.io/api
HEDERA_CHAIN_ID=296
MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com
HASHSCAN_BASE=https://hashscan.io/testnet

# ECDSA hex private key, with or without the 0x prefix
HEDERA_OPERATOR_KEY=
# Hedera entity id of the same account, e.g. 0.0.123456
HEDERA_OPERATOR_ID=

# Deployed spike contract, filled in by scripts/deploy.ts
SPIKE_CONTRACT_ADDRESS=

# x402 — Hedera track requires settlement through the Blocky402 facilitator
X402_FACILITATOR_URL=https://api.testnet.blocky402.com

# ── HoldEscrow ───────────────────────────────────────────────────────────
# The deployed escrow. Its Hedera entity id is the x402 payTo — the server
# resolves that from the mirror node at boot, so only the EVM address is needed.
ESCROW_ADDRESS=

# ── resource server (/server) ────────────────────────────────────────────
PORT=4021
# Price of one call, in TINYBARS (1 HBAR = 1e8).
# openHold costs the SELLER ~1.77 HBAR per hold (measured — scheduleCall's own
# ~1.45M gas floor dominates), so anything at or below ~2 HBAR loses money.
# 500000000 = 5 HBAR.
PRICE_TINYBAR=500000000
# How far out the refund is armed. The contract enforces a 30s floor.
HOLD_DEADLINE_SECONDS=60
# 1 = the seller takes payment and never reveals the key, so the refund fires.
# This is the demo switch; POST /admin/dark {"on":true} flips it at runtime.
DEMO_DARK=0
# Shared secret for POST /admin/dark. REQUIRED on a public deployment — without
# it anyone who can reach the URL can stop the seller revealing keys. Unset =
# the endpoint is disabled rather than left open.
ADMIN_TOKEN=
# The seller's signing key. On any public host this must NOT be the operator
# key: the operator OWNS the escrow (sweepReserve, setConfig, setOwner). The
# seller only needs to be an allowlisted opener.
#   npx hardhat run scripts/provision-seller.cjs --network hederaTestnet
SELLER_PRIVATE_KEY=
# Seconds the seller waits before revealing the key. 0 in normal operation.
# Set it for the demo so there is a window in which to kill the server on camera.
SELLER_CLAIM_DELAY_SECONDS=0

# ── agent (/agent) ───────────────────────────────────────────────────────
RESOURCE_URL=http://localhost:4021/premium
AGENT_QUERY=what is the airspeed velocity of an unladen swallow
AGENT_ROUNDS=1
# ECDSA hex key for the agent's own wallet. Must be a FUNDED Hedera account:
# paying an address Hedera has never seen also creates it, and that needs
# ~2,000,000 gas rather than a transfer's 21,000.
AGENT_PRIVATE_KEY=
